         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The American Society for Microbiologyâ€™s evidence-based laboratory medicine practice guidelines for the diagnosis of bloodstream infections using rapid tests: a systematic review and meta-analysis</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:identifier>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">CMR00137-24</rdf:li>
            </rdf:Alt>
         </dc:identifier>
         <dc:creator>
